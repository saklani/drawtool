#!/bin/sh
# drawtool for the Claude Code plugin. Plugin bin/ comes after the user's PATH,
# so a drawtool they installed themselves wins and this runs only when there is
# none: it fetches this platform's build from the latest release once per
# plugin version, checks it against the release's SHA256SUMS, then runs it.
set -e

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  Linux-x86_64) target=x86_64-unknown-linux-musl ;;
  Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-musl ;;
  *)
    echo "drawtool: no prebuilt binary for $(uname -s) $(uname -m); build it with" \
      "cargo install --git https://github.com/saklani/drawtool" >&2
    exit 1
    ;;
esac

# The plugin's own folder is named for its version, so an update fetches anew.
version=$(basename "$(cd "$(dirname "$0")/.." && pwd)")
dir="${XDG_CACHE_HOME:-$HOME/.cache}/drawtool/$version"
bin="$dir/drawtool"

fail() {
  rm -f "$bin.$$" "$dir/SHA256SUMS.$$"
  echo "drawtool: $1; build it with cargo install --git https://github.com/saklani/drawtool" >&2
  exit 1
}

if [ ! -x "$bin" ]; then
  base="${DRAWTOOL_DOWNLOAD:-https://github.com/saklani/drawtool/releases/latest/download}"
  mkdir -p "$dir"
  curl -fsSL "$base/drawtool-$target" -o "$bin.$$" || fail "couldn't download $base/drawtool-$target"
  curl -fsSL "$base/SHA256SUMS" -o "$dir/SHA256SUMS.$$" || fail "couldn't download $base/SHA256SUMS"
  want=$(awk -v f="drawtool-$target" '$2 == f || $2 == "*" f { print $1 }' "$dir/SHA256SUMS.$$")
  if command -v sha256sum >/dev/null; then
    got=$(sha256sum "$bin.$$" | cut -d' ' -f1)
  else
    got=$(shasum -a 256 "$bin.$$" | cut -d' ' -f1)
  fi
  [ -n "$want" ] && [ "$got" = "$want" ] || fail "drawtool-$target doesn't match its SHA256SUMS entry"
  rm -f "$dir/SHA256SUMS.$$"
  chmod +x "$bin.$$"
  mv "$bin.$$" "$bin"
fi

exec "$bin" "$@"
